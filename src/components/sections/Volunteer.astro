---
import Section from "../Section.astro";
import { getCV } from "@/i18n/cv";
import { useTranslations } from "@/i18n/ui";
import Heart from "pixelarticons/svg/heart.svg";

const t = useTranslations(Astro.currentLocale);
const { volunteer } = getCV(Astro.currentLocale);
---

{
	volunteer.length > 0 && (
		<Section className={Astro.props.className} title={t("section.volunteer")}>
			<ul class="space-y-4 print:space-y-0">
				{volunteer.map(({ organization, position, startDate, endDate, summary, url }) => {
					const startYear = new Date(startDate).getFullYear();
					const endYear = endDate != null ? new Date(endDate).getFullYear() : t("date.present");

					return (
						<li class="flex items-baseline">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 hidden h-5 w-5 shrink-0 self-start retro:hidden! md:inline-block print:hidden" aria-hidden="true">
								<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
							</svg>
							<Heart class="mr-2 hidden size-5 shrink-0 self-start text-skin-hue classic:hidden! md:inline-block print:hidden" aria-hidden="true" />
							<div class="relative w-full items-baseline justify-between gap-2">
								<h3 class="mr-6 font-medium">
									{url ? (
										<a class="hover:text-skin-hue decoration-dotted underline-offset-[5px] hover:underline" href={url} target="_blank">
											{organization}
										</a>
									) : (
										organization
									)}
								</h3>
								<div class="text-sm text-skin-muted">{position}</div>
								{summary && <p class="mt-1 text-sm text-skin-muted">{summary}</p>}
								<time class="right-0 top-0 text-xs text-skin-muted md:absolute md:block">{`${startYear} - ${endYear}`}</time>
							</div>
						</li>
					);
				})}
			</ul>
		</Section>
	)
}
