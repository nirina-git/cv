---
import Section from "../Section.astro"
import { getCV } from "@/i18n/cv"
import { useTranslations } from "@/i18n/ui"

import HTML from "@/icons/html.astro"
import CSS from "@/icons/css.astro"
import JavaScript from "@/icons/javascript.astro"
import TypeScript from "@/icons/type.astro"
import React from "@/icons/react.astro"
import Node from "@/icons/node.astro"
import MySQL from "@/icons/sql.astro"
import Git from "@/icons/git.astro"
import GitHub from "@/icons/GitHub.astro"
import Tailwind from "@/icons/tailwind.astro"
import Next from "@/icons/next.astro"
import Swift from "@/icons/swift.astro"
import SwiftUI from "@/icons/swiftui.astro"
import Kotlin from "@/icons/kotlin.astro"
import Flutter from "@/icons/flutter.astro"
import ExternalLink from "pixelarticons/svg/external-link.svg"

const SKILLS_ICONS: Record<string, any> = {
  HTML,
  CSS,
  JavaScript,
  TypeScript,
  React,
  Node,
  MySQL,
  Git,
  GitHub,
  Next,
  Tailwind,
  Swift,
  SwiftUI,
  Kotlin,
  Flutter,
}

const t = useTranslations(Astro.currentLocale)
const { work } = getCV(Astro.currentLocale)
---
<Section className={Astro.props.className} title={t("section.experience")}>
  <ul class="flex flex-col">
    {work.map(({ name, startDate, endDate, position, summary, responsibilities, achievements, url, skills, location, location_type }) => {
      const startYear = new Date(startDate).getFullYear()
      const endYear = endDate != null ? new Date(endDate).getFullYear() : t("date.present")

      return (
        <li class="relative print:py-2">
          <div class="group relative grid pb-1 print:pb-0 transition-all print:grid-cols-1 print:gap-1 sm:grid-cols-12 sm:gap-8 md:gap-6 lg:hover:opacity-100! ">
            <header class="relative mt-1 text-xs font-semibold sm:col-span-2">
              <time datetime={startDate} data-title={startDate}>{startYear}</time> - <time datetime={endDate} data-title={endDate}>{endYear}</time>
            </header>
            <div class="relative flex flex-col pb-6 print:pb-0 before:-ml-6 sm:col-span-10 before:w-0.5 print:before:hidden before:absolute before:bg-[repeating-linear-gradient(to_bottom,rgb(var(--muted))_0_6px,transparent_6px_10px)] before:h-full before:mt-2">
            <div class="absolute size-2.5 bg-skin-hue mt-1.5 -translate-x-[28px] ring-3 print:hidden ring-skin-fill" aria-hidden="true"></div>
              <h3>
                <div class="inline-flex items-center text-lg print:text-base leading-tight group/link focus-visible:text-amber-500" aria-label="{position} - {company}">
                  <span>{position} <span>@</span> 
                  {url ? (
                    <a class="text-skin-hue" href={url} title={`${t("common.visit")} ${name}`} target="_blank">{name}</a>
                  ) : (
                    <span>{name}</span>
                  )}
                  {url &&
                    <span class="inline-block text-skin-hue print:[&>svg]:hidden">
                      <ExternalLink class="inline-block size-4 ml-1 transition-transform translate-y-px shrink-0 group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none" aria-hidden="true" />
                    </span>
                  }
                  </span>
                </div>
              </h3>
              {(location || location_type) && (
                <div class="text-xs text-skin-muted">
                  {location} {location && location_type && '-'} {location_type}
                </div>
              )}
              <div class="mt-4  print:gap-0 flex flex-col gap-4 print:text-xs text-sm" x-data="{ expanded: false }">
                {summary && (
                  <div class="flex flex-col gap-1">
                    <h4>{t("experience.summary")}</h4>
                    <ul class="text-skin-muted [&>li]:ml-4 flex list-[square] print:list-disc flex-col gap-2">
                      {Array.isArray(summary) ? (
                        summary.map(item => (
                          {item}
                        ))
                      ) : (
                        <li>{summary}</li>
                      )}
                    </ul>
                  </div>
                )}

                {(responsibilities?.length > 0 || achievements?.length > 0) && (
                <div class="print:block! md:after:from-skin-fill dark:md:after:to-skin-fill/0  flex relative flex-col max-sm:h-auto! print:h-auto! gap-4 print:gap-2 md:after:bg-linear-to-t md:after:absolute md:after:bottom-0 md:after:w-full print:after:hidden md:after:h-12 md:after:content-[''] " :class="expanded ? 'after:hidden' : ''" x-show="expanded" x-collapse.min.50px>
                {responsibilities?.length > 0 && (
                  <div class="flex flex-col gap-1">
                    <h4>{t("experience.responsibilities")}</h4>
                    <ul class="text-skin-muted [&>li]:ml-4 flex list-[square] print:list-disc flex-col gap-2">
                      {responsibilities.map((responsibility: string)=> (
                        <li>{responsibility}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {achievements?.length > 0 && (
                  <div class="flex flex-col gap-1">
                    <h4>{t("experience.achievements")}</h4>
                    <ul class="text-skin-muted [&>li]:ml-4 flex list-[square] print:list-disc flex-col gap-2">
                      {achievements.map((achievement: string) => (
                        <li>{achievement}</li>
                      ))}
                    </ul>
                  </div>
                )}
                </div>

                <button @click="expanded = ! expanded" class="print:hidden group/more w-fit cursor-pointer items-center justify-center gap-1.5 font-pixel text-sm text-skin-hue hover:text-skin-base flex">
                  <span x-text={`expanded ? '${t("experience.seeLess")}' : '${t("experience.seeMore")}'`}>{t("experience.seeMore")}</span>
                  <svg class="size-4 group-hover/more:translate-y-0.5 motion-reduce:transition-none" :class="{ 'rotate-180': expanded }" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true"><path d="M7 8H5v2h2v2h2v2h2v2h2v-2h2v-2h2v-2h2V8h-2v2h-2v2h-2v2h-2v-2H9v-2H7z" /></svg>
                </button>
                )}

                {skills?.length > 0 && (
                <ul class="flex print:hidden flex-wrap gap-2" aria-label={t("experience.technologies")}>
                  {skills.map(skill => {
                    const iconName = skill === "Next.js" ? "Next" : skill
                    const Icon = SKILLS_ICONS[iconName]
                    return (
                      <li class="pixel-border pixel-border-muted bg-skin-button-muted text-skin-hue print:p-0 print:bg-transparent print:text-zinc-800 print:shadow-none flex gap-1 items-center px-2 py-0.5 text-xs">
                        {Icon && <Icon />} <span>{skill}</span>
                      </li>
                    )
                  })}
                </ul>
                )}
              </div>
            </div>
        </div>
        </li>
      )
    })}
  </ul>  
</Section>
<style>
  @reference "../../styles/global.css";

  li::marker {
    @apply text-skin-hue;
  }
</style>